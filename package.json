{
  "name": "ai-studio-pc",
  "version": "1.0.0",
  "description": "AI Code Studio para PC — chat leve para testar o Ollama e outras IAs, com terminal, voz Francisca/Francisco, ZIP grande e foto virando texto",
  "author": "Maikon",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "programa": "electron .",
    "exe": "electron-builder --win nsis portable --x64 --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "msedge-tts": ">=1.3.4"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.maikon.aistudio.pc",
    "productName": "AI Studio",
    "executableName": "AIStudio",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "app/icons/icon-512.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AI Studio",
      "artifactName": "AIStudio-Instalar.exe",
      "include": "electron/instalar.nsh"
    },
    "portable": {
      "artifactName": "AIStudio-sem-instalar.exe"
    }
  },
  "portaDoPrograma": 7740
}